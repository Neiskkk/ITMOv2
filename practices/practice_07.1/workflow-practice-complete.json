      "id": "98b7e4b2-0961-4e53-81e9-4dbd6ba1f532",
      "name": "Continue if review missing"
    },
    {
      "parameters": {
        "jsCode": "const diff = $input.first().json.data;\n\nif (typeof diff !== 'string' || !diff.trim()) {\n  throw new Error('PR diff is empty');\n}\n\nconst context = $('Normalize PR context').first().json;\nconst lines = diff.split('\\n');\nconst blocks = [];\n\nlet path = null;\nlet oldPath = null;\n\nfor (let i = 0; i < lines.length; i++) {\n  const current = lines[i];\n\n  if (current.startsWith('diff --git ')) {\n    path = null;\n    oldPath = null;\n    continue;\n  }\n\n  if (current.startsWith('--- a/')) {\n    oldPath = current.slice(6);\n    continue;\n  }\n\n  if (current.startsWith('+++ b/')) {\n    path = current.slice(6);\n    continue;\n  }\n\n  if (current === '+++ /dev/null') {\n    path = oldPath;\n    continue;\n  }\n\n  if (!current.startsWith('@@ ')) {\n    continue;\n  }\n\n  const header = current.match(\n    /^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/\n  );\n\n  if (!header || !path) {\n    continue;\n  }\n\n  let oldLine = Number(header[1]);\n  let newLine = Number(header[2]);\n  let firstAddedLine = null;\n  let firstDeletedLine = null;\n\n  const hunk = [current];\n  let j = i + 1;\n\n  while (\n    j < lines.length &&\n    !lines[j].startsWith('@@ ') &&\n    !lines[j].startsWith('diff --git ')\n  ) {\n    const line = lines[j];\n    hunk.push(line);\n\n    if (line.startsWith('+') && !line.startsWith('+++')) {\n      if (firstAddedLine === null) {\n        firstAddedLine = newLine;\n      }\n      newLine++;\n    } else if (line.startsWith('-') && !line.startsWith('---')) {\n      if (firstDeletedLine === null) {\n        firstDeletedLine = oldLine;\n      }\n      oldLine++;\n    } else if (!line.startsWith('\\\\')) {\n      oldLine++;\n      newLine++;\n    }\n\n    j++;\n  }\n\n  const line = firstAddedLine ?? firstDeletedLine;\n\n  if (line !== null) {\n    blocks.push({\n      json: {\n        repo_full_name: context.repo_full_name,\n        pr_number: context.pr_number,\n        command: context.command,\n        path,\n        line,\n        side: firstAddedLine !== null ? 'RIGHT' : 'LEFT',\n        diff_block: hunk.join('\\n'),\n      },\n    });\n  }\n\n  i = j - 1;\n}\n\nif (blocks.length === 0) {\n  throw new Error('No changed diff blocks found');\n}\n\nreturn blocks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -144
      ],
      "id": "a0a94b4e-f912-4b09-a543-2d60d98ff6fd",
      "name": "Split diff into blocks"
    },
    {
      "parameters": {
        "jsCode": "const agentAnswers = $input.all();\nconst diffBlocks = $('Split diff into blocks').all();\n\nif (diffBlocks.length === 0) {\n  throw new Error('Diff blocks are missing');\n}\n\nif (agentAnswers.length !== diffBlocks.length) {\n  throw new Error(\n    `Expected ${diffBlocks.length} AI answers, received ${agentAnswers.length}`\n  );\n}\n\nconst comments = agentAnswers.map((answer, index) => {\n  const block = diffBlocks[index].json;\n  const body = String(answer.json.output ?? '').trim();\n\n  if (!body) {\n    throw new Error(`AI returned an empty comment for block ${index + 1}`);\n  }\n\n  return {\n    path: block.path,\n    line: Number(block.line),\n    side: block.side,\n    body,\n  };\n});\n\nreturn [\n  {\n    json: {\n      repo_full_name: diffBlocks[0].json.repo_full_name,\n      pr_number: diffBlocks[0].json.pr_number,\n      command: diffBlocks[0].json.command,\n      body: 'AI code review: точечные комментарии к изменённым блокам.',\n      event: 'COMMENT',\n      comments,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
